DATABASE_URL=postgresql+psycopg://signal:signal@localhost:5437/signal

# openai | azure
LLM_PROVIDER=azure
LLM_API_KEY=
LLM_MODEL=gpt-4o
EMBED_MODEL=text-embedding-3-small
STT_MODEL=whisper-1
TTS_MODEL=

# Azure OpenAI (when LLM_PROVIDER=azure)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_CHAT_DEPLOYMENT=gpt-4o
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Azure AI Speech (when STT_PROVIDER=azure)
STT_PROVIDER=azure
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=swedencentral
AZURE_TTS_VOICE=en-GB-SoniaNeural

DEMO_CACHE=0
APPROACH_BUDGET_DEFAULT=5
MATCH_DIRECT_THRESHOLD=0.85
MATCH_TRANSFERABLE_THRESHOLD=0.70

# Web ↔ API
NEXT_PUBLIC_API_URL=http://localhost:8000
APP_PUBLIC_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Auth (magic link). Demo personas still work when AUTH_ALLOW_DEMO=1.
AUTH_ALLOW_DEMO=1
AUTH_EXPOSE_DEV_LINK=1
AUTH_SESSION_HOURS=72
AUTH_MAGIC_LINK_MINUTES=30
AUTH_SECRET=dev-only-change-me
PRIVACY_NOTICE_VERSION=2026-11-14

# Railway: set to 1 so the API seeds demo data on boot (idempotent)
SEED_ON_STARTUP=0
